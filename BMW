<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta
    name="description"
    content="BMW 세단 중심의 비공식 딜러 웹사이트 포트폴리오 콘셉트"
  />
  <title>BMW PRIME SEOUL | Sedan Dealer Concept</title>

  <style>
    /* =========================================================
       1. COLOR SYSTEM
       BMW를 연상시키는 블루와 고급스러운 블랙/실버를 조합했습니다.
       ========================================================= */
    :root {
      --bmw-blue: #0066b1;
      --bmw-sky: #00a8e8;
      --bmw-deep-blue: #003d78;

      --carbon: #05070a;
      --obsidian: #090d12;
      --graphite: #111820;
      --graphite-2: #18212b;

      --silver: #bcc5cf;
      --silver-2: #e1e6eb;
      --white: #f7f9fb;

      --m-light-blue: #55a7d9;
      --m-blue: #164b8e;
      --m-red: #d31f35;

      --text-main: #f5f7fa;
      --text-muted: #9ba7b3;
      --line: rgba(255, 255, 255, 0.12);

      --shadow: 0 28px 80px rgba(0, 0, 0, 0.42);
      --max-width: 1240px;
      --radius-lg: 30px;
      --radius-md: 20px;
      --radius-sm: 12px;
    }

    /* =========================================================
       2. BASIC RESET
       ========================================================= */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 90px;
    }

    body {
      min-width: 320px;
      overflow-x: hidden;
      background: var(--carbon);
      color: var(--text-main);
      font-family:
        "Pretendard",
        "Apple SD Gothic Neo",
        "Noto Sans KR",
        Arial,
        Helvetica,
        sans-serif;
      line-height: 1.6;
    }

    body::selection {
      background: var(--bmw-blue);
      color: #fff;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    select,
    input {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    img,
    svg {
      display: block;
      max-width: 100%;
    }

    .container {
      width: min(92%, var(--max-width));
      margin: 0 auto;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: #c7d3df;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      width: 26px;
      height: 2px;
      content: "";
      background: linear-gradient(90deg, var(--bmw-sky), var(--bmw-blue));
    }

    .section {
      padding: 110px 0;
    }

    .section-heading {
      display: grid;
      grid-template-columns: 1fr 0.8fr;
      gap: 60px;
      align-items: end;
      margin-bottom: 48px;
    }

    .section-title {
      margin-top: 14px;
      color: var(--white);
      font-size: clamp(2.2rem, 5vw, 4.4rem);
      line-height: 1.03;
      letter-spacing: -0.045em;
    }

    .section-description {
      max-width: 610px;
      color: var(--text-muted);
      font-size: 0.96rem;
    }

    /* =========================================================
       3. NAVIGATION
       ========================================================= */
    .site-header {
      position: fixed;
      z-index: 1000;
      top: 0;
      left: 0;
      width: 100%;
      border-bottom: 1px solid transparent;
      transition:
        background 0.25s ease,
        border-color 0.25s ease,
        backdrop-filter 0.25s ease;
    }

    .site-header.scrolled {
      border-color: var(--line);
      background: rgba(5, 7, 10, 0.8);
      backdrop-filter: blur(18px);
    }

    .nav {
      display: flex;
      min-height: 82px;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-mark {
      position: relative;
      display: grid;
      width: 42px;
      height: 42px;
      overflow: hidden;
      place-items: center;
      border: 1px solid rgba(255, 255, 255, 0.56);
      border-radius: 50%;
      background: #070a0e;
      font-size: 0.63rem;
      font-weight: 800;
      letter-spacing: 0.08em;
    }

    .brand-mark::before,
    .brand-mark::after {
      position: absolute;
      z-index: -1;
      width: 21px;
      height: 21px;
      content: "";
      background: var(--bmw-blue);
    }

    .brand-mark::before {
      right: 0;
      bottom: 0;
    }

    .brand-mark::after {
      top: 0;
      left: 0;
      opacity: 0.42;
    }

    .brand-copy strong {
      display: block;
      font-size: 0.82rem;
      letter-spacing: 0.13em;
    }

    .brand-copy span {
      display: block;
      margin-top: 2px;
      color: #7e8995;
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 30px;
      list-style: none;
      color: #c0c8d1;
      font-size: 0.84rem;
      font-weight: 600;
    }

    .nav-links a {
      position: relative;
      padding: 10px 0;
    }

    .nav-links a::after {
      position: absolute;
      bottom: 4px;
      left: 0;
      width: 0;
      height: 1px;
      content: "";
      background: var(--bmw-sky);
      transition: width 0.2s ease;
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    .nav-cta {
      display: inline-flex;
      min-height: 42px;
      align-items: center;
      justify-content: center;
      padding: 0 18px;
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.06);
      color: #fff;
      font-size: 0.8rem;
      font-weight: 700;
      transition:
        transform 0.2s ease,
        background 0.2s ease;
    }

    .nav-cta:hover {
      transform: translateY(-2px);
      background: rgba(255, 255, 255, 0.12);
    }

    /* =========================================================
       4. HERO
       - 마우스에 반응하는 spotlight
       - JS로 모델명/문구/스펙이 자동 교체됩니다.
       ========================================================= */
    .hero {
      position: relative;
      min-height: 100svh;
      overflow: hidden;
      background:
        radial-gradient(circle at 74% 28%, rgba(0, 102, 177, 0.18), transparent 27%),
        linear-gradient(135deg, #05070a 0%, #0a0e14 50%, #05070a 100%);
      isolation: isolate;
    }

    .hero::before {
      position: absolute;
      z-index: -3;
      inset: 0;
      content: "";
      opacity: 0.16;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: linear-gradient(to bottom, #000 0%, transparent 82%);
    }

    .hero-spotlight {
      position: absolute;
      z-index: -2;
      top: 0;
      left: 0;
      width: 620px;
      height: 620px;
      border-radius: 50%;
      opacity: 0.78;
      background:
        radial-gradient(circle, rgba(0, 168, 232, 0.2) 0%, rgba(0, 102, 177, 0.08) 34%, transparent 69%);
      filter: blur(16px);
      pointer-events: none;
      transform: translate(-50%, -50%);
      transition: opacity 0.3s ease;
    }

    .hero-layout {
      display: grid;
      min-height: 100svh;
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
      gap: 30px;
      padding-top: 110px;
      padding-bottom: 54px;
    }

    .hero-copy {
      position: relative;
      z-index: 4;
      padding: 50px 0;
    }

    .hero-kicker {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
      color: #aab6c2;
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .m-stripes {
      display: inline-flex;
      width: 34px;
      height: 4px;
      overflow: hidden;
      transform: skewX(-22deg);
    }

    .m-stripes span {
      flex: 1;
    }

    .m-stripes span:nth-child(1) {
      background: var(--m-light-blue);
    }

    .m-stripes span:nth-child(2) {
      background: var(--m-blue);
    }

    .m-stripes span:nth-child(3) {
      background: var(--m-red);
    }

    .hero-model-index {
      margin-bottom: 8px;
      color: var(--bmw-sky);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .hero h1 {
      max-width: 720px;
      color: #fff;
      font-size: clamp(4rem, 9vw, 8.5rem);
      font-weight: 700;
      line-height: 0.86;
      letter-spacing: -0.065em;
      text-transform: uppercase;
    }

    .hero h1 .outline {
      display: block;
      color: transparent;
      -webkit-text-stroke: 1px rgba(255, 255, 255, 0.45);
    }

    .hero-tagline {
      max-width: 520px;
      min-height: 64px;
      margin-top: 28px;
      color: #bac4ce;
      font-size: clamp(1rem, 2vw, 1.2rem);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 32px;
    }

    .button {
      display: inline-flex;
      min-height: 50px;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 0 22px;
      border: 1px solid transparent;
      border-radius: 999px;
      font-size: 0.84rem;
      font-weight: 800;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        border-color 0.2s ease;
    }

    .button:hover {
      transform: translateY(-2px);
    }

    .button-primary {
      background: linear-gradient(90deg, var(--bmw-blue), #1487d1);
      box-shadow: 0 14px 34px rgba(0, 102, 177, 0.28);
      color: #fff;
    }

    .button-secondary {
      border-color: rgba(255, 255, 255, 0.22);
      background: rgba(255, 255, 255, 0.045);
      color: #fff;
    }

    .hero-specs {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 38px;
    }

    .spec-chip {
      min-width: 118px;
      padding: 13px 15px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.04);
      backdrop-filter: blur(10px);
    }

    .spec-chip strong {
      display: block;
      color: #fff;
      font-size: 0.96rem;
    }

    .spec-chip span {
      display: block;
      margin-top: 3px;
      color: #7f8b96;
      font-size: 0.66rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .hero-visual {
      position: relative;
      min-height: 660px;
      perspective: 1200px;
    }

    .hero-car-stage {
      position: absolute;
      top: 50%;
      left: 50%;
      width: min(760px, 104%);
      transform: translate(-48%, -47%);
      transform-style: preserve-3d;
      transition: transform 0.15s ease-out;
    }

    .car-aura {
      position: absolute;
      z-index: -2;
      right: 4%;
      bottom: 8%;
      width: 74%;
      height: 25%;
      border-radius: 50%;
      opacity: 0.68;
      background: rgba(0, 102, 177, 0.28);
      filter: blur(60px);
    }

    .car-platform {
      position: absolute;
      z-index: -1;
      right: 3%;
      bottom: 10%;
      width: 78%;
      height: 16%;
      border-radius: 50%;
      background:
        radial-gradient(ellipse, rgba(255, 255, 255, 0.12), rgba(0, 0, 0, 0.08) 46%, transparent 72%);
      filter: blur(3px);
      transform: rotate(-1deg);
    }

    .sedan-svg {
      overflow: visible;
      filter: drop-shadow(0 45px 35px rgba(0, 0, 0, 0.55));
    }

    .car-body-main {
      fill: url(#carPaint);
      stroke: rgba(255, 255, 255, 0.22);
      stroke-width: 1.1;
    }

    .car-window {
      fill: url(#glass);
      stroke: rgba(141, 205, 246, 0.27);
      stroke-width: 0.8;
    }

    .car-line {
      fill: none;
      stroke: rgba(255, 255, 255, 0.25);
      stroke-width: 1.1;
    }

    .car-light {
      fill: #dff5ff;
      filter: drop-shadow(0 0 8px #5fc8ff);
    }

    .wheel-ring {
      fill: #06080b;
      stroke: #8a949f;
      stroke-width: 2;
    }

    .wheel-inner {
      fill: #1a222a;
      stroke: #c4ccd4;
      stroke-width: 1;
    }

    .wheel-spoke {
      stroke: #8e98a3;
      stroke-width: 2;
    }

    .hero-series-watermark {
      position: absolute;
      z-index: -1;
      top: 7%;
      right: -4%;
      color: rgba(255, 255, 255, 0.025);
      font-size: clamp(12rem, 24vw, 23rem);
      font-weight: 800;
      line-height: 1;
      letter-spacing: -0.08em;
      pointer-events: none;
      user-select: none;
    }

    .hero-side-info {
      position: absolute;
      right: 0;
      bottom: 6%;
      display: flex;
      align-items: center;
      gap: 16px;
      color: #7d8994;
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      transform: rotate(-90deg) translateX(100%);
      transform-origin: bottom right;
    }

    .hero-side-info::before {
      width: 55px;
      height: 1px;
      content: "";
      background: #52606d;
    }

    .hero-dots {
      position: absolute;
      z-index: 8;
      right: 4%;
      bottom: 7%;
      display: flex;
      gap: 8px;
    }

    .hero-dot {
      width: 34px;
      height: 4px;
      border: 0;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.18);
      transition:
        width 0.25s ease,
        background 0.25s ease;
    }

    .hero-dot.active {
      width: 58px;
      background: var(--bmw-sky);
    }

    /* =========================================================
       5. MODELS
       ========================================================= */
    .models-section {
      background:
        linear-gradient(180deg, #080b0f 0%, #0a0f15 100%);
    }

    .model-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-bottom: 30px;
    }

    .filter-button {
      padding: 9px 15px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 999px;
      background: transparent;
      color: #8f9ba7;
      font-size: 0.76rem;
      font-weight: 700;
    }

    .filter-button.active {
      border-color: rgba(0, 168, 232, 0.45);
      background: rgba(0, 102, 177, 0.14);
      color: #dcefff;
    }

    .model-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 18px;
    }

    .model-card {
      position: relative;
      min-height: 450px;
      overflow: hidden;
      padding: 28px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-md);
      background:
        radial-gradient(circle at 65% 30%, rgba(0, 102, 177, 0.14), transparent 36%),
        #0d131a;
      transition:
        transform 0.3s ease,
        border-color 0.3s ease;
    }

    .model-card:hover {
      transform: translateY(-6px);
      border-color: rgba(0, 168, 232, 0.36);
    }

    .model-card:nth-child(1),
    .model-card:nth-child(2) {
      grid-column: span 6;
    }

    .model-card:nth-child(n + 3) {
      grid-column: span 4;
    }

    .model-card.hidden {
      display: none;
    }

    .model-card-top {
      position: relative;
      z-index: 3;
      display: flex;
      justify-content: space-between;
      gap: 20px;
    }

    .model-category {
      color: var(--bmw-sky);
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.11em;
      text-transform: uppercase;
    }

    .model-card h3 {
      margin-top: 7px;
      color: #fff;
      font-size: 1.85rem;
      letter-spacing: -0.04em;
    }

    .model-badge {
      height: max-content;
      padding: 6px 9px;
      border: 1px solid rgba(255, 255, 255, 0.13);
      border-radius: 999px;
      color: #8e9ba7;
      font-size: 0.65rem;
    }

    .model-art {
      position: relative;
      height: 220px;
      margin: 24px -4px 18px;
    }

    .mini-car {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 104%;
      height: 110px;
      transform: translate(-50%, -50%);
    }

    .mini-car::before {
      position: absolute;
      top: 31px;
      left: 15%;
      width: 70%;
      height: 54px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 49% 56% 18% 17% / 70% 78% 25% 24%;
      content: "";
      background:
        linear-gradient(160deg, rgba(255, 255, 255, 0.14), rgba(12, 18, 25, 0.3) 37%, rgba(0, 102, 177, 0.4));
      box-shadow:
        inset 0 0 40px rgba(255, 255, 255, 0.03),
        0 25px 42px rgba(0, 0, 0, 0.48);
      transform: skewX(-5deg);
    }

    .mini-car::after {
      position: absolute;
      top: 14px;
      left: 31%;
      width: 38%;
      height: 48px;
      border: 1px solid rgba(129, 188, 225, 0.25);
      border-radius: 48% 48% 8% 8%;
      content: "";
      background: linear-gradient(160deg, rgba(77, 128, 159, 0.32), rgba(7, 12, 17, 0.92));
      transform: skewX(-9deg);
    }

    .mini-wheel {
      position: absolute;
      z-index: 4;
      top: 70px;
      width: 38px;
      height: 38px;
      border: 4px solid #10151a;
      border-radius: 50%;
      background:
        radial-gradient(circle, #8d99a4 0 16%, #26313b 17% 41%, #0b0f13 43% 100%);
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.5);
    }

    .mini-wheel.front {
      right: 20%;
    }

    .mini-wheel.rear {
      left: 21%;
    }

    .mini-headlight {
      position: absolute;
      z-index: 5;
      top: 58px;
      right: 13.5%;
      width: 34px;
      height: 4px;
      border-radius: 99px;
      background: #d9f4ff;
      box-shadow: 0 0 13px #66c9ff;
    }

    .model-card[data-power="electric"] .mini-car::before {
      background:
        linear-gradient(160deg, rgba(255, 255, 255, 0.12), rgba(13, 28, 42, 0.48) 37%, rgba(0, 168, 232, 0.42));
    }

    .model-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      padding-top: 18px;
      border-top: 1px solid rgba(255, 255, 255, 0.09);
    }

    .model-stats div {
      min-width: 100px;
    }

    .model-stats strong {
      display: block;
      color: #e7edf2;
      font-size: 0.86rem;
    }

    .model-stats span {
      display: block;
      margin-top: 2px;
      color: #77838e;
      font-size: 0.65rem;
      text-transform: uppercase;
    }

    .model-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-top: 20px;
    }

    .model-card-footer p {
      color: #6f7d89;
      font-size: 0.68rem;
    }

    .text-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 0;
      background: none;
      color: #d8e9f6;
      font-size: 0.76rem;
      font-weight: 800;
    }

    .text-link:hover {
      color: var(--bmw-sky);
    }

    /* =========================================================
       6. EXPERIENCE / DEALER BENEFITS
       ========================================================= */
    .experience {
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(135deg, #0b1117 0%, #0c1520 54%, #07111b 100%);
    }

    .experience::after {
      position: absolute;
      top: -30%;
      right: -15%;
      width: 700px;
      height: 700px;
      border-radius: 50%;
      content: "";
      background: rgba(0, 102, 177, 0.12);
      filter: blur(80px);
    }

    .benefit-grid {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .benefit-card {
      min-height: 250px;
      padding: 28px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-md);
      background: rgba(255, 255, 255, 0.035);
      backdrop-filter: blur(14px);
    }

    .benefit-number {
      color: var(--bmw-sky);
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.12em;
    }

    .benefit-card h3 {
      margin: 52px 0 10px;
      color: #fff;
      font-size: 1.25rem;
    }

    .benefit-card p {
      color: #8e9aa6;
      font-size: 0.87rem;
    }

    /* =========================================================
       7. QUOTE AREA
       견적 '요청' 데모입니다. 실제 금융 계산은 하지 않습니다.
       ========================================================= */
    .quote-section {
      background: #f3f5f7;
      color: #10151a;
    }

    .quote-section .eyebrow {
      color: #5a6671;
    }

    .quote-section .section-title {
      color: #0a0e12;
    }

    .quote-section .section-description {
      color: #69747d;
    }

    .quote-shell {
      display: grid;
      overflow: hidden;
      grid-template-columns: 0.78fr 1.22fr;
      border-radius: 30px;
      background: #fff;
      box-shadow: 0 25px 75px rgba(18, 28, 38, 0.12);
    }

    .quote-preview {
      position: relative;
      display: flex;
      min-height: 560px;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      padding: 38px;
      background:
        radial-gradient(circle at 70% 34%, rgba(0, 168, 232, 0.24), transparent 32%),
        linear-gradient(155deg, #071019, #0b1722 48%, #071019);
      color: #fff;
    }

    .quote-preview::after {
      position: absolute;
      right: -120px;
      bottom: -210px;
      width: 460px;
      height: 460px;
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 50%;
      content: "";
      box-shadow:
        0 0 0 65px rgba(255, 255, 255, 0.018),
        0 0 0 130px rgba(255, 255, 255, 0.012);
    }

    .quote-model-label {
      color: var(--bmw-sky);
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .quote-preview h3 {
      position: relative;
      z-index: 2;
      margin-top: 6px;
      font-size: clamp(2.5rem, 5vw, 5.3rem);
      line-height: 0.92;
      letter-spacing: -0.06em;
    }

    .quote-preview-bottom {
      position: relative;
      z-index: 2;
    }

    .quote-preview-bottom p {
      max-width: 320px;
      color: #8b99a5;
      font-size: 0.82rem;
    }

    .quote-accent-line {
      width: 70px;
      height: 3px;
      margin-bottom: 16px;
      background: linear-gradient(90deg, var(--bmw-sky), var(--bmw-blue));
    }

    .quote-form {
      padding: 42px;
    }

    .quote-form h3 {
      margin-bottom: 8px;
      font-size: 1.4rem;
    }

    .quote-form > p {
      margin-bottom: 28px;
      color: #78828c;
      font-size: 0.84rem;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .form-group {
      display: grid;
      gap: 7px;
    }

    .form-group.full {
      grid-column: 1 / -1;
    }

    .form-group label {
      color: #46505a;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.04em;
    }

    .field {
      width: 100%;
      min-height: 50px;
      padding: 0 14px;
      border: 1px solid #d9dee3;
      border-radius: 10px;
      outline: none;
      background: #fff;
      color: #13181d;
      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .field:focus {
      border-color: var(--bmw-blue);
      box-shadow: 0 0 0 3px rgba(0, 102, 177, 0.1);
    }

    .range-wrap {
      padding: 11px 0 4px;
    }

    input[type="range"] {
      width: 100%;
      accent-color: var(--bmw-blue);
    }

    .range-meta {
      display: flex;
      justify-content: space-between;
      margin-top: 6px;
      color: #7c8791;
      font-size: 0.68rem;
    }

    .range-meta strong {
      color: #17202a;
    }

    .quote-submit {
      width: 100%;
      min-height: 52px;
      margin-top: 24px;
      border: 0;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--bmw-blue), #137fca);
      box-shadow: 0 12px 26px rgba(0, 102, 177, 0.22);
      color: #fff;
      font-weight: 800;
    }

    .quote-result {
      display: none;
      margin-top: 16px;
      padding: 14px;
      border: 1px solid rgba(0, 102, 177, 0.14);
      border-radius: 12px;
      background: #eef6fb;
      color: #25465d;
      font-size: 0.78rem;
    }

    .quote-result.show {
      display: block;
    }

    /* =========================================================
       8. FOOTER
       ========================================================= */
    .site-footer {
      padding: 44px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      background: #05070a;
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      gap: 30px;
      color: #68737e;
      font-size: 0.7rem;
    }

    .footer-inner strong {
      color: #a9b3bd;
    }

    /* =========================================================
       9. REVEAL ANIMATION
       ========================================================= */
    [data-reveal] {
      opacity: 0;
      transform: translateY(26px);
      transition:
        opacity 0.65s ease,
        transform 0.65s ease;
    }

    [data-reveal].visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* =========================================================
       10. RESPONSIVE
       ========================================================= */
    @media (max-width: 980px) {
      .nav-links {
        display: none;
      }

      .hero-layout,
      .section-heading,
      .quote-shell {
        grid-template-columns: 1fr;
      }

      .hero-layout {
        padding-top: 140px;
      }

      .hero-visual {
        min-height: 520px;
      }

      .hero-car-stage {
        width: min(710px, 108%);
      }

      .section-heading {
        gap: 20px;
      }

      .model-card:nth-child(n) {
        grid-column: span 6;
      }

      .benefit-grid {
        grid-template-columns: 1fr;
      }

      .quote-preview {
        min-height: 390px;
      }
    }

    @media (max-width: 650px) {
      .section {
        padding: 82px 0;
      }

      .brand-copy span {
        display: none;
      }

      .nav-cta {
        min-height: 38px;
        padding: 0 13px;
        font-size: 0.7rem;
      }

      .hero-layout {
        display: block;
        min-height: auto;
      }

      .hero h1 {
        font-size: clamp(3.7rem, 22vw, 6.3rem);
      }

      .hero-visual {
        min-height: 370px;
      }

      .hero-side-info {
        display: none;
      }

      .hero-dots {
        right: auto;
        bottom: 1%;
        left: 0;
      }

      .model-card:nth-child(n) {
        grid-column: 1 / -1;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .form-group.full {
        grid-column: auto;
      }

      .quote-form {
        padding: 28px 22px;
      }

      .quote-preview {
        padding: 28px 24px;
      }

      .footer-inner {
        flex-direction: column;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
      }
    }
  </style>
</head>

