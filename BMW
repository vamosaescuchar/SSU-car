    <section class="section quote-section" id="quote">
      <div class="container">
        <div class="section-heading" data-reveal>
          <div>
            <span class="eyebrow">Request an estimate</span>
            <h2 class="section-title">당신의 BMW,<br />견적부터 시작하세요.</h2>
          </div>

          <p class="section-description">
            이 폼은 GitHub 포트폴리오용 프론트엔드 데모입니다.
            실제 계약이나 금융 신청이 이루어지지 않으며, 제출 시 선택 내용을 화면에 요약합니다.
          </p>
        </div>

        <div class="quote-shell" data-reveal>
          <aside class="quote-preview">
            <div>
              <span class="quote-model-label">Selected model</span>
              <h3 id="quotePreviewModel">BMW<br />5 SERIES</h3>
            </div>

            <div class="quote-preview-bottom">
              <div class="quote-accent-line"></div>
              <p>
                원하는 모델과 구매 방식을 선택하면 상담 요청 정보를 아래에서 확인할 수 있습니다.
              </p>
            </div>
          </aside>

          <form class="quote-form" id="quoteForm">
            <h3>빠른 견적 상담</h3>
            <p>실제 개인정보를 입력하지 않아도 데모 동작을 확인할 수 있습니다.</p>

            <div class="form-grid">
              <div class="form-group full">
                <label for="modelSelect">MODEL</label>
                <select class="field" id="modelSelect" required>
                  <option value="BMW 3 Series">BMW 3 Series</option>
                  <option value="BMW 5 Series" selected>BMW 5 Series</option>
                  <option value="BMW i5">BMW i5</option>
                  <option value="BMW 7 Series">BMW 7 Series</option>
                  <option value="BMW i7">BMW i7</option>
                </select>
              </div>

              <div class="form-group">
                <label for="purchaseType">PURCHASE TYPE</label>
                <select class="field" id="purchaseType" required>
                  <option>할부 상담</option>
                  <option>리스 상담</option>
                  <option>현금 구매</option>
                  <option>구매 방식 추천받기</option>
                </select>
              </div>

              <div class="form-group">
                <label for="testDrive">TEST DRIVE</label>
                <select class="field" id="testDrive">
                  <option>시승도 함께 신청</option>
                  <option>견적만 먼저 확인</option>
                </select>
              </div>

              <div class="form-group full">
                <label for="budgetRange">MONTHLY BUDGET</label>

                <div class="range-wrap">
                  <input
                    id="budgetRange"
                    type="range"
                    min="50"
                    max="500"
                    value="150"
                    step="10"
                  />

                  <div class="range-meta">
                    <span>월 50만 원</span>
                    <strong id="budgetValue">월 150만 원 수준</strong>
                    <span>월 500만 원+</span>
                  </div>
                </div>
              </div>

              <div class="form-group">
                <label for="customerName">NAME · DEMO</label>
                <input
                  class="field"
                  id="customerName"
                  type="text"
                  placeholder="예: 홍길동"
                />
              </div>

              <div class="form-group">
                <label for="customerContact">CONTACT · DEMO</label>
                <input
                  class="field"
                  id="customerContact"
                  type="text"
                  placeholder="실제 연락처 입력 불필요"
                />
              </div>
            </div>

            <button class="quote-submit" type="submit">
              선택한 조건으로 견적 요청하기
            </button>

            <div class="quote-result" id="quoteResult" role="status"></div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p>
        <strong>BMW PRIME SEOUL</strong> — Unofficial portfolio dealer concept.
      </p>

      <p>
        BMW 및 각 모델명은 해당 권리자의 상표입니다. 본 페이지는 학습·포트폴리오용 비공식 데모입니다.
      </p>
    </div>
  </footer>

  <script>
    /* =========================================================
       1. HERO MODEL DATA
       공개된 BMW Korea 모델 정보 중 대표값만 사용했습니다.
       실제 차량 가격/프로모션/사양은 변경될 수 있습니다.
       ========================================================= */
    const heroModels = [
      {
        index: "01 / 03 · Executive Sedan",
        title: "THE",
        series: "5",
        tagline:
          "비즈니스의 품격과 일상의 다이내믹을 하나의 세단에. BMW 5시리즈를 중심으로 당신에게 맞는 세단을 만나보세요.",
        specOne: "530i xDrive",
        specTwo: "11.1 km/L",
        specTwoLabel: "Combined economy",
      },
      {
        index: "02 / 03 · Sports Sedan",
        title: "THE",
        series: "3",
        tagline:
          "운전의 즐거움이라는 BMW의 핵심을 가장 선명하게 보여주는 스포츠 세단. 일상에서도 경쾌한 균형을 경험하세요.",
        specOne: "320i",
        specTwo: "190 PS",
        specTwoLabel: "Max output",
      },
      {
        index: "03 / 03 · Electric Sedan",
        title: "THE",
        series: "i5",
        tagline:
          "5시리즈의 비즈니스 감각에 순수전기 구동을 더한 i5. 정숙함과 즉각적인 반응을 새로운 프리미엄으로 제안합니다.",
        specOne: "i5 eDrive40",
        specTwo: "453 km",
        specTwoLabel: "Certified range",
      },
    ];

    /* =========================================================
       2. DOM ELEMENTS
       자주 사용할 HTML 요소를 JavaScript 변수에 저장합니다.
       ========================================================= */
    const siteHeader = document.getElementById("siteHeader");
    const hero = document.querySelector(".hero");
    const heroSpotlight = document.getElementById("heroSpotlight");
    const heroCarStage = document.getElementById("heroCarStage");

    const heroIndex = document.getElementById("heroIndex");
    const heroTitle = document.getElementById("heroTitle");
    const heroTagline = document.getElementById("heroTagline");
    const heroSpecOne = document.getElementById("heroSpecOne");
    const heroSpecTwo = document.getElementById("heroSpecTwo");
    const heroSpecTwoLabel = document.getElementById("heroSpecTwoLabel");
    const heroWatermark = document.getElementById("heroWatermark");
    const heroDots = document.getElementById("heroDots");

    let activeHeroIndex = 0;
    let heroTimer;

    /* =========================================================
       3. HERO DOTS
       모델 수만큼 하단 인디케이터 버튼을 자동 생성합니다.
       ========================================================= */
    heroModels.forEach((model, index) => {
      const dot = document.createElement("button");

      dot.className = "hero-dot";
      dot.type = "button";
      dot.setAttribute("aria-label", `${model.series} 모델 보기`);

      dot.addEventListener("click", () => {
        setHero(index);
        resetHeroTimer();
      });

      heroDots.appendChild(dot);
    });

    /* =========================================================
       4. HERO CONTENT SWITCH
       모델 변경 시 텍스트를 교체하고 살짝 페이드 효과를 줍니다.
       ========================================================= */
    function setHero(index) {
      activeHeroIndex = index;

      const model = heroModels[index];

      const textTargets = [
        heroIndex,
        heroTitle,
        heroTagline,
        heroSpecOne,
        heroSpecTwo,
        heroSpecTwoLabel,
        heroWatermark,
      ];

      textTargets.forEach((element) => {
        element.style.opacity = "0";
        element.style.transform = "translateY(8px)";
      });

      window.setTimeout(() => {
        heroIndex.textContent = model.index;

        heroTitle.innerHTML = `${model.title}<span class="outline">${model.series}</span>`;

        heroTagline.textContent = model.tagline;
        heroSpecOne.textContent = model.specOne;
        heroSpecTwo.textContent = model.specTwo;
        heroSpecTwoLabel.textContent = model.specTwoLabel;
        heroWatermark.textContent = model.series;

        document.querySelectorAll(".hero-dot").forEach((dot, dotIndex) => {
          dot.classList.toggle("active", dotIndex === index);
        });

        textTargets.forEach((element) => {
          element.style.transition =
            "opacity .35s ease, transform .35s ease";
          element.style.opacity = "1";
          element.style.transform = "translateY(0)";
        });
      }, 170);
    }

    function nextHero() {
      const nextIndex = (activeHeroIndex + 1) % heroModels.length;
      setHero(nextIndex);
    }

    function resetHeroTimer() {
      window.clearInterval(heroTimer);
      heroTimer = window.setInterval(nextHero, 5200);
    }

    setHero(0);
    resetHeroTimer();

    /* =========================================================
       5. HERO MOUSE EFFECT
       마우스 위치에 따라 빛과 차량 SVG가 약간 움직입니다.
       ========================================================= */
    hero.addEventListener("pointermove", (event) => {
      const rect = hero.getBoundingClientRect();

      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;

      heroSpotlight.style.left = `${x}px`;
      heroSpotlight.style.top = `${y}px`;

      const normalizedX = x / rect.width - 0.5;
      const normalizedY = y / rect.height - 0.5;

      heroCarStage.style.transform =
        `translate(-48%, -47%) rotateY(${normalizedX * 6}deg) rotateX(${normalizedY * -3}deg) translate3d(${normalizedX * 10}px, ${normalizedY * 8}px, 0)`;
    });

    hero.addEventListener("pointerleave", () => {
      heroCarStage.style.transform =
        "translate(-48%, -47%) rotateY(0deg) rotateX(0deg)";
    });

    /* =========================================================
       6. STICKY HEADER
       스크롤을 내리면 헤더에 블러 배경을 추가합니다.
       ========================================================= */
    function updateHeader() {
      siteHeader.classList.toggle("scrolled", window.scrollY > 24);
    }

    window.addEventListener("scroll", updateHeader);
    updateHeader();

    /* =========================================================
       7. MODEL FILTER
       가솔린 / 전기 / 플래그십 필터 기능입니다.
       ========================================================= */
    const filterButtons = document.querySelectorAll(".filter-button");
    const modelCards = document.querySelectorAll(".model-card");

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const selectedFilter = button.dataset.filter;

        filterButtons.forEach((item) => item.classList.remove("active"));
        button.classList.add("active");

        modelCards.forEach((card) => {
          const cardFilters = card.dataset.filterType.split(" ");

          const shouldShow =
            selectedFilter === "all" || cardFilters.includes(selectedFilter);

          card.classList.toggle("hidden", !shouldShow);
        });
      });
    });

    /* =========================================================
       8. QUOTE MODEL SHORTCUT
       모델 카드의 '견적 보기'를 누르면 견적 폼으로 이동하고
       해당 모델을 자동 선택합니다.
       ========================================================= */
    const quoteButtons = document.querySelectorAll(".quote-model");
    const modelSelect = document.getElementById("modelSelect");
    const quotePreviewModel = document.getElementById("quotePreviewModel");

    function updateQuotePreview(modelName) {
      const parts = modelName.replace("BMW ", "").split(" ");

      if (parts.length === 1) {
        quotePreviewModel.innerHTML = `BMW<br>${parts[0].toUpperCase()}`;
      } else {
        quotePreviewModel.innerHTML =
          `BMW<br>${parts.join(" ").toUpperCase()}`;
      }
    }

    quoteButtons.forEach((button) => {
      button.addEventListener("click", () => {
        modelSelect.value = button.dataset.model;
        updateQuotePreview(button.dataset.model);

        document.getElementById("quote").scrollIntoView({
          behavior: "smooth",
        });
      });
    });

    modelSelect.addEventListener("change", () => {
      updateQuotePreview(modelSelect.value);
    });

    /* =========================================================
       9. BUDGET RANGE
       슬라이더의 현재 값을 화면에 표시합니다.
       ========================================================= */
    const budgetRange = document.getElementById("budgetRange");
    const budgetValue = document.getElementById("budgetValue");

    function updateBudget() {
      budgetValue.textContent = `월 ${budgetRange.value}만 원 수준`;
    }

    budgetRange.addEventListener("input", updateBudget);
    updateBudget();

    /* =========================================================
       10. QUOTE FORM DEMO
       서버가 없는 정적 GitHub 페이지이므로 실제 전송 대신
       사용자가 선택한 값을 화면에 요약합니다.
       ========================================================= */
    const quoteForm = document.getElementById("quoteForm");
    const quoteResult = document.getElementById("quoteResult");
    const purchaseType = document.getElementById("purchaseType");
    const testDrive = document.getElementById("testDrive");

    quoteForm.addEventListener("submit", (event) => {
      event.preventDefault();

      quoteResult.innerHTML = `
        <strong>${modelSelect.value}</strong> ·
        ${purchaseType.value} ·
        월 예산 ${budgetRange.value}만 원 ·
        ${testDrive.value}<br>
        포트폴리오 데모이므로 실제 상담 요청은 전송되지 않았습니다.
      `;

      quoteResult.classList.add("show");
    });

    /* =========================================================
       11. SCROLL REVEAL
       화면 안으로 들어오는 요소를 부드럽게 등장시킵니다.
       ========================================================= */
    const revealElements = document.querySelectorAll("[data-reveal]");

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            revealObserver.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
      }
    );

    revealElements.forEach((element) => {
      revealObserver.observe(element);
    });
  </script>
</body>
</html>
